/* Lumen Stream — Blackout theme.
 * True black background for OLED, amber-orange accent.
 * Placeholders: {{ACCENT}}, {{ACCENT_DIM}}, {{ACCENT_SOFT}}, {{ACCENT_GHOST}}
 */

* {
    font-family: "Inter", "Segoe UI", "SF Pro Text", "Roboto", "Noto Sans", sans-serif;
    color: #F2F2F2;
}

QMainWindow, QDialog {
    background-color: #000000;
}

QWidget#sideBar {
    background-color: #050505;
    border-right: 1px solid #161616;
}

QWidget#contentArea {
    background-color: #0A0A0A;
}

QLabel#brandTitle {
    color: {{ACCENT}};
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel#brandSub {
    color: #888888;
    font-size: 11px;
    letter-spacing: 1.4px;
}

/* Sidebar nav buttons */
QPushButton[role="nav"] {
    background-color: transparent;
    border: none;
    color: #B8B8B8;
    text-align: left;
    padding: 12px 18px;
    font-size: 13px;
    font-weight: 500;
    border-left: 3px solid transparent;
}

QPushButton[role="nav"]:hover {
    color: #FFFFFF;
    background-color: {{ACCENT_GHOST}};
}

QPushButton[role="nav"][selected="true"] {
    color: {{ACCENT}};
    border-left: 3px solid {{ACCENT}};
    background-color: {{ACCENT_GHOST}};
}

/* Cards */
QFrame[role="card"] {
    background-color: #111111;
    border: 1px solid #1F1F1F;
    border-radius: 14px;
}

/* Primary action — Go Live */
QPushButton[role="primary"] {
    background-color: {{ACCENT}};
    color: #0A0A0A;
    border: none;
    border-radius: 10px;
    padding: 12px 28px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QPushButton[role="primary"]:hover {
    background-color: {{ACCENT_SOFT}};
}

QPushButton[role="primary"]:pressed {
    background-color: {{ACCENT_DIM}};
}

QPushButton[role="primary"][live="true"] {
    background-color: #E03B3B;
    color: #FFFFFF;
}

QPushButton[role="secondary"] {
    background-color: transparent;
    color: #E0E0E0;
    border: 1px solid #2A2A2A;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton[role="secondary"]:hover {
    border-color: {{ACCENT}};
    color: {{ACCENT}};
}

/* Inputs */
QLineEdit, QSpinBox, QComboBox {
    background-color: #0F0F0F;
    color: #F2F2F2;
    border: 1px solid #222222;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: {{ACCENT_GHOST}};
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: {{ACCENT}};
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #0A0A0A;
    color: #F2F2F2;
    border: 1px solid #222222;
    selection-background-color: {{ACCENT_GHOST}};
    selection-color: {{ACCENT}};
}

/* Status pill */
QLabel#statusPill {
    background-color: #161616;
    color: #888888;
    padding: 4px 12px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

QLabel#statusPill[live="true"] {
    background-color: #E03B3B;
    color: #FFFFFF;
}

/* Section headers */
QLabel[role="sectionHeader"] {
    color: #888888;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.6px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #1F1F1F;
    border-radius: 12px;
    background: #0A0A0A;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #888888;
    padding: 10px 18px;
    margin-right: 4px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: {{ACCENT}};
    background: #111111;
    border: 1px solid #1F1F1F;
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    color: #F2F2F2;
}

/* Plain text box for ffmpeg log */
QPlainTextEdit#logView {
    background-color: #050505;
    color: #B8B8B8;
    border: 1px solid #1F1F1F;
    border-radius: 10px;
    font-family: "JetBrains Mono", "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    padding: 8px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #2A2A2A;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: {{ACCENT_DIM}};
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QCheckBox {
    color: #E0E0E0;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 4px;
    border: 1px solid #2A2A2A;
    background: #0A0A0A;
}
QCheckBox::indicator:checked {
    background: {{ACCENT}};
    border-color: {{ACCENT}};
}
